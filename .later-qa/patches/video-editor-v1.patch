+@Composable
+private fun LaterVideoTimeline(
+    thumbnails: List<Bitmap?>,
+    durationMs: Long,
+    startMs: Long,
+    endMs: Long,
+    playheadMs: Long,
+    minimumTrimMs: Long,
+    onSeek: (Long) -> Unit,
+    onTrimChange: (Long, Long) -> Unit,
+    onTrimFinished: () -> Unit
+) {
+    var widthPx by remember { mutableFloatStateOf(1f) }
+    val density = LocalDensity.current
+    val accent = MaterialTheme.colorScheme.primary
+    val placeholder = MaterialTheme.colorScheme.surfaceVariant
+    val currentStart = rememberUpdatedState(startMs)
+    val currentEnd = rememberUpdatedState(endMs)
+    val handleHitRadiusPx = with(density) { 28.dp.toPx() }
+
+    fun xToTime(x: Float): Long {
+        if (durationMs <= 0L) return 0L
+        return ((x.coerceIn(0f, widthPx) / widthPx) * durationMs.toFloat())
+            .toLong()
+            .coerceIn(0L, durationMs)
+    }
+
+    Box(
+        Modifier
+            .fillMaxWidth()
+            .height(72.dp)
+            .padding(horizontal = 16.dp)
+            .clip(RoundedCornerShape(12.dp))
+            .background(placeholder)
+            .onSizeChanged { widthPx = it.width.toFloat().coerceAtLeast(1f) }
+            .semantics { contentDescription = "Video trim timeline" }
+            .pointerInput(durationMs, widthPx, minimumTrimMs) {
+                var dragTarget = 0
+                var gestureStartMs = 0L
+                var gestureEndMs = 0L
+                var accumulatedPx = 0f
+                detectDragGestures(
+                    onDragStart = { offset ->
+                        gestureStartMs = currentStart.value
+                        gestureEndMs = currentEnd.value
+                        accumulatedPx = 0f
+                        val startX = if (durationMs > 0L) widthPx * (gestureStartMs.toFloat() / durationMs.toFloat()) else 0f
+                        val endX = if (durationMs > 0L) widthPx * (gestureEndMs.toFloat() / durationMs.toFloat()) else widthPx
+                        dragTarget = when {
+                            abs(offset.x - startX) <= handleHitRadiusPx -> 1
+                            abs(offset.x - endX) <= handleHitRadiusPx -> 2
+                            else -> 3
+                        }
+                        when (dragTarget) {
+                            1 -> onSeek(gestureStartMs)
+                            2 -> onSeek(gestureEndMs)
+                            else -> onSeek(xToTime(offset.x))
+                        }
+                    },
+                    onDragEnd = {
+                        if (dragTarget == 1 || dragTarget == 2) onTrimFinished()
+                        dragTarget = 0
+                    },
+                    onDragCancel = {
+                        if (dragTarget == 1 || dragTarget == 2) onTrimFinished()
+                        dragTarget = 0
+                    }
+                ) { change, dragAmount ->
+                    change.consume()
+                    if (dragTarget == 3) {
+                        onSeek(xToTime(change.position.x))
+                    } else {
+                        accumulatedPx += dragAmount.x
+                        val deltaMs = if (durationMs > 0L) {
+                            (durationMs.toFloat() * accumulatedPx / widthPx).toLong()
+                        } else 0L
+                        if (dragTarget == 1) {
+                            val maxStart = (gestureEndMs - minimumTrimMs).coerceAtLeast(0L)
+                            val nextStart = (gestureStartMs + deltaMs).coerceIn(0L, maxStart)
+                            onTrimChange(nextStart, gestureEndMs)
+                            onSeek(nextStart)
+                        } else if (dragTarget == 2) {
+                            val minEnd = (gestureStartMs + minimumTrimMs).coerceAtMost(durationMs)
+                            val nextEnd = (gestureEndMs + deltaMs).coerceIn(minEnd, durationMs)
+                            onTrimChange(gestureStartMs, nextEnd)
+                            onSeek(nextEnd)
+                        }
+                    }
+                }
+            }
+            .pointerInput(durationMs, widthPx) {
+                detectTapGestures { offset -> onSeek(xToTime(offset.x)) }
+            }
+    ) {
+        Row(Modifier.fillMaxSize()) {
+            if (thumbnails.isEmpty()) {
+                Box(Modifier.weight(1f).fillMaxHeight().background(placeholder))
+            } else {
+                thumbnails.forEach { bitmap ->
+                    if (bitmap != null) {
+                        Image(
+                            bitmap = bitmap.asImageBitmap(),
+                            contentDescription = null,
+                            modifier = Modifier.weight(1f).fillMaxHeight(),
+                            contentScale = ContentScale.Crop
+                        )
+                    } else {
+                        Box(Modifier.weight(1f).fillMaxHeight().background(placeholder))
+                    }
+                }
+            }
+        }
+
+        Canvas(Modifier.fillMaxSize()) {
+            if (durationMs <= 0L) return@Canvas
+            val startX = size.width * (startMs.coerceIn(0L, durationMs).toFloat() / durationMs.toFloat())
+            val endX = size.width * (endMs.coerceIn(0L, durationMs).toFloat() / durationMs.toFloat())
+            val playX = size.width * (playheadMs.coerceIn(0L, durationMs).toFloat() / durationMs.toFloat())
+            val border = 3.dp.toPx()
+            val handleWidth = 11.dp.toPx()
+            val handleRadius = CornerRadius(4.dp.toPx(), 4.dp.toPx())
+            val dim = Color.Black.copy(alpha = 0.58f)
+
+            if (startX > 0f) drawRect(dim, size = Size(startX, size.height))
+            if (endX < size.width) drawRect(dim, topLeft = Offset(endX, 0f), size = Size(size.width - endX, size.height))
+            drawLine(accent, Offset(startX, border / 2f), Offset(endX, border / 2f), border)
+            drawLine(accent, Offset(startX, size.height - border / 2f), Offset(endX, size.height - border / 2f), border)
+
+            drawLine(Color.Black.copy(alpha = 0.72f), Offset(playX, 0f), Offset(playX, size.height), 4.dp.toPx())
+            drawLine(Color.White, Offset(playX, 0f), Offset(playX, size.height), 2.dp.toPx())
+            val knobY = 7.dp.toPx()
+            drawCircle(Color.Black.copy(alpha = 0.72f), radius = 6.dp.toPx(), center = Offset(playX, knobY))
+            drawCircle(Color.White, radius = 3.5.dp.toPx(), center = Offset(playX, knobY))
+
+            val maxHandleX = (size.width - handleWidth).coerceAtLeast(0f)
+            val leftHandleX = startX.coerceIn(0f, maxHandleX)
+            val rightHandleX = (endX - handleWidth).coerceIn(0f, maxHandleX)
+            drawRoundRect(accent, Offset(leftHandleX, 0f), Size(handleWidth, size.height), handleRadius)
+            drawRoundRect(accent, Offset(rightHandleX, 0f), Size(handleWidth, size.height), handleRadius)
+            val grip = Color.Black.copy(alpha = 0.45f)
+            drawLine(grip, Offset(leftHandleX + handleWidth / 2f, size.height * 0.36f), Offset(leftHandleX + handleWidth / 2f, size.height * 0.64f), 1.dp.toPx())
+            drawLine(grip, Offset(rightHandleX + handleWidth / 2f, size.height * 0.36f), Offset(rightHandleX + handleWidth / 2f, size.height * 0.64f), 1.dp.toPx())
+        }
+    }
+}
+private fun shareEditedVideo(context: Context, video: LaterEditedVideo) {
+    val intent = android.content.Intent(android.content.Intent.ACTION_SEND).apply {
+        type = video.mimeType
+        putExtra(android.content.Intent.EXTRA_STREAM, Uri.parse(video.uri))
+        addFlags(android.content.Intent.FLAG_GRANT_READ_URI_PERMISSION)
+    }
+    runCatching { context.startActivity(android.content.Intent.createChooser(intent, "Share edited video")) }
+}
+
+private fun mediaUriForVideo(source: String): Uri {
+    val uri = Uri.parse(source)
+    return if (uri.scheme.isNullOrBlank()) Uri.fromFile(File(source)) else uri
+}
+
+private fun readVideoDuration(context: Context, uri: Uri): Long {
+    val retriever = MediaMetadataRetriever()
+    return try {
+        retriever.setDataSource(context, uri)
+        retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_DURATION)?.toLongOrNull() ?: 0L
+    } finally { retriever.release() }
+}
+
+private fun readVideoThumbnails(context: Context, uri: Uri, durationMs: Long): List<Bitmap?> {
+    val retriever = MediaMetadataRetriever()
+    return try {
+        retriever.setDataSource(context, uri)
+        val sampleCount = when {
+            durationMs <= 15_000L -> 10
+            durationMs <= 60_000L -> 9
+            durationMs <= 5 * 60_000L -> 8
+            else -> 7
+        }
+        (0 until sampleCount).map { index ->
+            val divisor = (sampleCount - 1).coerceAtLeast(1)
+            val atUs = (durationMs * 1000L * index / divisor).coerceIn(0L, (durationMs * 1000L).coerceAtLeast(1L))
+            retriever.getFrameAtTime(atUs, MediaMetadataRetriever.OPTION_CLOSEST)?.let { frame ->
+                val maxWidth = 160
+                if (frame.width <= maxWidth) frame else {
+                    val height = (frame.height * (maxWidth.toFloat() / frame.width)).toInt().coerceAtLeast(1)
+                    Bitmap.createScaledBitmap(frame, maxWidth, height, true).also { scaled ->
+                        if (scaled !== frame && !frame.isRecycled) frame.recycle()
+                    }
+                }
+            }
+        }
+    } finally {
+        retriever.release()
+    }
+}
+
+private fun formatVideoTime(valueMs: Long): String {
+    val total = valueMs.coerceAtLeast(0L) / 1000L
+    return "%d:%02d".format(total / 60L, total % 60L)
+}
+
+private fun formatTrimTime(valueMs: Long): String {
+    val safe = valueMs.coerceAtLeast(0L)
+    val minutes = safe / 60_000L
+    val seconds = (safe % 60_000L) / 1000L
+    val tenths = (safe % 1000L) / 100L
+    return "%02d:%02d.%d".format(minutes, seconds, tenths)
+}
+
+private fun formatTrimSpan(valueMs: Long): String {
+    val safe = valueMs.coerceAtLeast(0L)
+    return "${safe / 1000L}.${(safe % 1000L) / 100L}s"
+}
+
+private const val VIDEO_EXPORT_PENDING_SUFFIX = ".pending"
+
+internal fun pendingVideoExportMarker(output: File): File {
+    val directory = output.parentFile ?: error("Video export output must have a parent directory.")
+    return File(directory, output.name + VIDEO_EXPORT_PENDING_SUFFIX)
+}
+
+internal fun markVideoExportPending(output: File) {
+    output.parentFile?.mkdirs()
+    pendingVideoExportMarker(output).writeText(output.name)
+}
+
+internal fun completePendingVideoExport(output: File) {
+    pendingVideoExportMarker(output).delete()
+}
+
+internal fun discardPendingVideoExport(output: File): Boolean {
+    val outputGone = !output.exists() || output.delete()
+    val marker = pendingVideoExportMarker(output)
+    val markerGone = if (outputGone) !marker.exists() || marker.delete() else false
+    return outputGone && markerGone
+}
+
+internal fun recoverInterruptedVideoExports(directory: File): Int {
+    if (!directory.isDirectory) return 0
+    var recovered = 0
+    directory.listFiles()
+        .orEmpty()
+        .asSequence()
+        .filter { it.isFile && it.name.endsWith(".mp4$VIDEO_EXPORT_PENDING_SUFFIX") }
+        .forEach { marker ->
+            val output = File(directory, marker.name.removeSuffix(VIDEO_EXPORT_PENDING_SUFFIX))
+            val outputGone = !output.exists() || output.delete()
+            if (outputGone) {
+                marker.delete()
+                recovered++
+            }
+        }
+    return recovered
+}
