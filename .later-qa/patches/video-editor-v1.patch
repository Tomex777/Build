+private fun shareVideoSource(context: android.content.Context, source: String, mimeType: String?) {
+    val uri = mediaUri(source)
+    val intent = Intent(Intent.ACTION_SEND).apply {
+        type = mimeType?.takeIf { it.startsWith("video/") } ?: "video/*"
+        putExtra(Intent.EXTRA_STREAM, uri)
+        addFlags(Intent.FLAG_GRANT_READ_URI_PERMISSION)
+    }
+    runCatching { context.startActivity(Intent.createChooser(intent, "Share video")) }
+}
