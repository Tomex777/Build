+package com.night.later.ui.media
+
+import java.io.File
+import java.nio.file.Files
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class LaterVideoExportRecoveryTest {
+    @Test
+    fun `recovery removes only marker backed interrupted exports`() {
+        val directory = Files.createTempDirectory("later-video-recovery").toFile()
+        try {
+            val interrupted = File(directory, "interrupted.mp4").apply { writeText("partial") }
+            markVideoExportPending(interrupted)
+            val committed = File(directory, "committed.mp4").apply { writeText("ready") }
+
+            assertEquals(1, recoverInterruptedVideoExports(directory))
+            assertFalse(interrupted.exists())
+            assertFalse(pendingVideoExportMarker(interrupted).exists())
+            assertTrue(committed.exists())
+            assertEquals("ready", committed.readText())
+        } finally {
+            directory.deleteRecursively()
+        }
+    }
+
+    @Test
+    fun `commit clears marker without deleting playable output`() {
+        val directory = Files.createTempDirectory("later-video-commit").toFile()
+        try {
+            val output = File(directory, "edited.mp4").apply { writeText("playable") }
+            markVideoExportPending(output)
+            assertTrue(pendingVideoExportMarker(output).isFile)
+
+            completePendingVideoExport(output)
+
+            assertTrue(output.isFile)
+            assertFalse(pendingVideoExportMarker(output).exists())
+        } finally {
+            directory.deleteRecursively()
+        }
+    }
+}

