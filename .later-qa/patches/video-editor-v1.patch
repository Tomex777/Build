+ data class LaterEditedVideo(
+    val path: String,
+    val uri: String,
+    val mimeType: String = "video/mp4",
+    val displayName: String
+)
+
+@OptIn(UnstableApi::class)
+@Composable
+fun LaterVideoEditor(
+    source: String,
+    displayName: String?,
+    onDismiss: () -> Unit,
+    onSaved: (LaterEditedVideo) -> Unit
+) {
+    val context = LocalContext.current
+    val sourceUri = remember(source) { mediaUriForVideo(source) }
+    val durationState by produceState(initialValue = 0L, source) {
+        value = withContext(Dispatchers.IO) { runCatching { readVideoDuration(context, sourceUri) }.getOrDefault(0L) }
+    }
+    val duration = durationState
+    val thumbnails by produceState<List<Bitmap?>>(initialValue = emptyList(), source, duration) {
+        if (duration > 0L) value = withContext(Dispatchers.IO) {
+            runCatching { readVideoThumbnails(context, sourceUri, duration) }.getOrDefault(emptyList())
+        }
+    }
+    var startMs by remember(source, duration) { mutableLongStateOf(0L) }
+    var endMs by remember(source, duration) { mutableLongStateOf(duration) }
+    val trimHistory = remember(source, duration) { mutableStateListOf(0L to duration) }
+    var historyIndex by remember(source, duration) { mutableIntStateOf(0) }
+    var playheadMs by remember(source) { mutableLongStateOf(0L) }
+    var exporting by remember(source) { mutableStateOf(false) }
+    var progress by remember(source) { mutableIntStateOf(0) }
+    var error by remember(source) { mutableStateOf<String?>(null) }
+    var completed by remember(source) { mutableStateOf<LaterEditedVideo?>(null) }
+    var transformer by remember(source) { mutableStateOf<Transformer?>(null) }
+    var outputFile by remember(source) { mutableStateOf<File?>(null) }
+    val player = remember(source) {
+        ExoPlayer.Builder(context).build().apply {
+            setMediaItem(MediaItem.fromUri(sourceUri))
+            prepare()
+        }
+    }
+    DisposableEffect(player) { onDispose { player.release() } }
+
+    val dismissEditor = {
+        if (!exporting) {
+            if (completed != null) outputFile?.delete()
+            onDismiss()
+        }
+    }
+
+    LaunchedEffect(exporting, transformer) {
+        while (exporting) {
+            val holder = ProgressHolder()
+            runCatching {
+                if (transformer?.getProgress(holder) == Transformer.PROGRESS_STATE_AVAILABLE) {
+                    progress = holder.progress
+                }
+            }
+            delay(450)
+        }
+    }
+    LaunchedEffect(player) {
+        while (true) {
+            playheadMs = player.currentPosition.coerceAtLeast(0L)
+            delay(200)
+        }
+    }
+    val latestCompleted = rememberUpdatedState(completed)
+    val latestTransformer = rememberUpdatedState(transformer)
+    val latestOutput = rememberUpdatedState(outputFile)
+    val latestThumbnails = rememberUpdatedState(thumbnails)
+    DisposableEffect(Unit) {
+        onDispose {
+            latestTransformer.value?.cancel()
+            latestOutput.value?.takeIf { it.exists() && latestCompleted.value == null }?.delete()
+            latestThumbnails.value.filterNotNull().forEach { if (!it.isRecycled) it.recycle() }
+        }
+    }
+
+    Dialog(
+        onDismissRequest = dismissEditor,
+        properties = DialogProperties(usePlatformDefaultWidth = false, decorFitsSystemWindows = false)
+    ) {
+        Column(Modifier.fillMaxSize().background(MaterialTheme.colorScheme.background)) {
+            Row(Modifier.fillMaxWidth().padding(horizontal = 10.dp, vertical = 8.dp), verticalAlignment = Alignment.CenterVertically) {
+                IconButton(onClick = dismissEditor, enabled = !exporting) {
+                    Icon(Icons.AutoMirrored.Rounded.ArrowBack, contentDescription = "Close video editor")
+                }
+                Text("Trim video", modifier = Modifier.weight(1f), style = MaterialTheme.typography.titleMedium)
+                TextButton(
+                    enabled = duration > 0L && !exporting && endMs - startMs >= 500L,
+                    onClick = {
+                        error = null
+                        val target = File(context.cacheDir, "video_edits/${UUID.randomUUID()}.mp4")
+                        target.parentFile?.mkdirs()
+                        outputFile = target
+                        val item = MediaItem.Builder()
+                            .setUri(sourceUri)
+                            .setClippingConfiguration(
+                                MediaItem.ClippingConfiguration.Builder()
+                                    .setStartPositionMs(startMs)
+                                    .setEndPositionMs(endMs)
+                                    .build()
+                            )
+                            .build()
+                        val listener = object : Transformer.Listener {
+                            override fun onCompleted(composition: Composition, exportResult: ExportResult) {
+                                exporting = false
+                                val file = outputFile
+                                val playable = file?.takeIf { it.isFile && it.length() > 0L }
+                                if (playable == null) {
+                                    error = "The export did not create a playable file."
+                                } else {
+                                    val name = "${displayName?.substringBeforeLast('.')?.ifBlank { "Video" } ?: "Video"}_edited.mp4"
+                                    completed = LaterEditedVideo(
+                                        path = playable.absolutePath,
+                                        uri = FileProvider.getUriForFile(context, "${context.packageName}.files", playable).toString(),
+                                        displayName = name
+                                    )
+                                }
+                            }
+                            override fun onError(composition: Composition, exportResult: ExportResult, exportException: ExportException) {
+                                exporting = false
+                                error = exportException.localizedMessage ?: "Video export failed. The original is unchanged."
+                                outputFile?.delete()
+                            }
+                        }
+                        runCatching {
+                            val worker = Transformer.Builder(context)
+                                .setVideoMimeType(MimeTypes.VIDEO_H264)
+                                .setAudioMimeType(MimeTypes.AUDIO_AAC)
+                                .addListener(listener)
+                                .build()
+                            transformer = worker
+                            exporting = true
+                            progress = 0
+                            worker.start(EditedMediaItem.Builder(item).build(), target.absolutePath)
+                        }.onFailure {
+                            exporting = false
+                            error = it.localizedMessage ?: "Could not start video export."
+                        }
+                    }
+                ) { Text(if (exporting) "Exporting…" else "Export MP4") }
+            }
+
+            Text(
+                "Exports an edited MP4 copy. The original video stays unchanged.",
+                modifier = Modifier.fillMaxWidth().padding(horizontal = 20.dp, vertical = 4.dp),
+                style = MaterialTheme.typography.bodySmall
+            )
+
+            Box(Modifier.weight(1f).fillMaxWidth().padding(horizontal = 12.dp, vertical = 8.dp), contentAlignment = Alignment.Center) {
+                AndroidView(
+                    factory = { viewContext -> PlayerView(viewContext).apply { useController = true; this.player = player } },
+                    update = { it.player = player },
+                    modifier = Modifier.fillMaxSize()
+                )
+            }
+
+            Row(Modifier.fillMaxWidth().padding(horizontal = 18.dp), verticalAlignment = Alignment.CenterVertically) {
+                Text(formatVideoTime(playheadMs), style = MaterialTheme.typography.labelMedium)
+                Slider(
+                    value = playheadMs.coerceIn(0L, duration.coerceAtLeast(1L)).toFloat(),
+                    onValueChange = { player.seekTo(it.toLong()); playheadMs = it.toLong() },
+                    valueRange = 0f..duration.coerceAtLeast(1L).toFloat(),
+                    modifier = Modifier.weight(1f)
+                )
+                Text(formatVideoTime(duration), style = MaterialTheme.typography.labelMedium)
+            }
+
+            LazyRow(
+                modifier = Modifier.fillMaxWidth().height(58.dp).padding(horizontal = 16.dp),
+                horizontalArrangement = Arrangement.spacedBy(4.dp),
+                verticalAlignment = Alignment.CenterVertically
+            ) {
+                items(thumbnails) { bitmap ->
+                    if (bitmap != null) Image(bitmap.asImageBitmap(), "Video frame", Modifier.size(width = 64.dp, height = 48.dp), contentScale = ContentScale.Crop)
+                    else Box(Modifier.size(width = 64.dp, height = 48.dp).background(MaterialTheme.colorScheme.surfaceVariant))
+                }
+            }
+            if (duration > 500L) {
+                RangeSlider(
+                    value = startMs.toFloat().coerceIn(0f, duration.toFloat())..endMs.toFloat().coerceIn(0f, duration.toFloat()),
+                    onValueChange = { range ->
+                        val safeStart = range.start.toLong().coerceIn(0L, duration - 500L)
+                        val safeEnd = range.endInclusive.toLong().coerceIn(safeStart + 500L, duration)
+                        startMs = safeStart
+                        endMs = safeEnd
+                        player.seekTo(safeStart)
+                    },
+                    onValueChangeFinished = {
+                        val current = startMs to endMs
+                        while (trimHistory.lastIndex > historyIndex) trimHistory.removeAt(trimHistory.lastIndex)
+                        if (trimHistory.lastOrNull() != current) trimHistory.add(current)
+                        historyIndex = trimHistory.lastIndex
+                    },
+                    valueRange = 0f..duration.toFloat(),
+                    modifier = Modifier.fillMaxWidth().padding(horizontal = 18.dp)
+                )
+            }
+            Row(Modifier.fillMaxWidth().padding(horizontal = 24.dp), horizontalArrangement = Arrangement.SpaceBetween) {
+                Text("Start  ${formatVideoTime(startMs)}", style = MaterialTheme.typography.labelMedium)
+                Text("End  ${formatVideoTime(endMs)}", style = MaterialTheme.typography.labelMedium)
+            }
+            Row(Modifier.fillMaxWidth().padding(horizontal = 16.dp), horizontalArrangement = Arrangement.End) {
+                TextButton(onClick = {
+                    if (historyIndex > 0) {
+                        historyIndex--
+                        val range = trimHistory[historyIndex]
+                        startMs = range.first; endMs = range.second; player.seekTo(startMs)
+                    }
+                }, enabled = historyIndex > 0) { Text("Undo") }
+                TextButton(onClick = {
+                    if (historyIndex < trimHistory.lastIndex) {
+                        historyIndex++
+                        val range = trimHistory[historyIndex]
+                        startMs = range.first; endMs = range.second; player.seekTo(startMs)
+                    }
+                }, enabled = historyIndex < trimHistory.lastIndex) { Text("Redo") }
+                TextButton(onClick = {
+                    startMs = 0L; endMs = duration; player.seekTo(0L)
+                    trimHistory.clear(); trimHistory.add(0L to duration); historyIndex = 0
+                }) { Text("Reset") }
+            }
+
+            if (exporting) {
+                Row(Modifier.fillMaxWidth().padding(16.dp), verticalAlignment = Alignment.CenterVertically) {
+                    CircularProgressIndicator(progress = { progress / 100f }, modifier = Modifier.size(28.dp), strokeWidth = 3.dp)
+                    Text("  Exporting $progress%", modifier = Modifier.weight(1f))
+                    TextButton(onClick = { transformer?.cancel(); outputFile?.delete(); exporting = false; transformer = null }) {
+                        Icon(Icons.Rounded.Cancel, contentDescription = null)
+                        Text("Cancel")
+                    }
+                }
+            }
+            error?.let { Text(it, color = MaterialTheme.colorScheme.error, modifier = Modifier.padding(horizontal = 20.dp, vertical = 8.dp)) }
+            completed?.let { result ->
+                Surface(color = MaterialTheme.colorScheme.surfaceVariant, modifier = Modifier.fillMaxWidth().padding(12.dp), shape = RoundedCornerShape(18.dp)) {
+                    Column(Modifier.padding(14.dp)) {
+                        Text("Edited MP4 is ready", style = MaterialTheme.typography.titleSmall)
+                        Text("${result.displayName} · ${result.path.let { File(it).length() / 1024 } } KB", style = MaterialTheme.typography.bodySmall)
+                        Row(horizontalArrangement = Arrangement.End, modifier = Modifier.fillMaxWidth()) {
+                            TextButton(onClick = { shareEditedVideo(context, result) }) { Text("Share") }
+                            TextButton(onClick = { completed = null; outputFile?.delete(); outputFile = null }) { Text("Discard") }
+                            TextButton(onClick = { onSaved(result) }) { Text("Update capsule") }
+                        }
+                    }
+                }
+            }
+        }
+    }
+}
+
+private fun shareEditedVideo(context: Context, video: LaterEditedVideo) {
+    val intent = android.content.Intent(android.content.Intent.ACTION_SEND).apply {
+        type = video.mimeType
+        putExtra(android.content.Intent.EXTRA_STREAM, Uri.parse(video.uri))
+        addFlags(android.content.Intent.FLAG_GRANT_READ_URI_PERMISSION)
+    }
+    runCatching { context.startActivity(android.content.Intent.createChooser(intent, "Share edited video")) }
+}
+
+private fun mediaUriForVideo(source: String): Uri {
+    val uri = Uri.parse(source)
+    return if (uri.scheme.isNullOrBlank()) Uri.fromFile(File(source)) else uri
+}
+
+private fun readVideoDuration(context: Context, uri: Uri): Long {
+    val retriever = MediaMetadataRetriever()
+    return try {
+        retriever.setDataSource(context, uri)
+        retriever.extractMetadata(MediaMetadataRetriever.METADATA_KEY_DURATION)?.toLongOrNull() ?: 0L
+    } finally { retriever.release() }
+}
+
+private fun readVideoThumbnails(context: Context, uri: Uri, durationMs: Long): List<Bitmap?> {
+    val retriever = MediaMetadataRetriever()
+    return try {
+        retriever.setDataSource(context, uri)
+        (0..7).map { index ->
+            val atUs = (durationMs * 1000L * index / 7.coerceAtLeast(1)).coerceIn(0L, (durationMs * 1000L).coerceAtLeast(1L))
+            retriever.getFrameAtTime(atUs, MediaMetadataRetriever.OPTION_CLOSEST_SYNC)?.let { frame ->
+                val maxWidth = 180
+                if (frame.width <= maxWidth) frame else {
+                    val height = (frame.height * (maxWidth.toFloat() / frame.width)).toInt().coerceAtLeast(1)
+                    Bitmap.createScaledBitmap(frame, maxWidth, height, true).also { scaled ->
+                        if (scaled !== frame && !frame.isRecycled) frame.recycle()
+                    }
+                }
+            }
+        }
+    } finally { retriever.release() }
+}
+
+private fun formatVideoTime(valueMs: Long): String {
+    val total = valueMs.coerceAtLeast(0L) / 1000L
+    return "%d:%02d".format(total / 60L, total % 60L)
+}
