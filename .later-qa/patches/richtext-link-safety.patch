+    /**
+     * Link targets are navigation requests. Only standard external schemes are
+     * accepted, and web links must have a host. This also keeps old v1 HTML
+     * readable while preventing a crafted saved document from restoring a
+     * javascript:, data:, or other app-launching target.
+     */
+    fun isAllowedLinkUrl(value: String): Boolean {
+        val candidate = value.trim()
+        if (candidate.isEmpty() || candidate.any { it.isWhitespace() || it.isISOControl() }) {
+            return false
+        }
+
+        val uri = runCatching { URI(candidate) }.getOrNull() ?: return false
+        val scheme = uri.scheme?.lowercase(Locale.ROOT) ?: return false
+        return when (scheme) {
+            "http", "https" -> !uri.host.isNullOrBlank()
+            "mailto" -> !uri.schemeSpecificPart.isNullOrBlank()
+            "tel" -> uri.schemeSpecificPart.any(Char::isDigit)
+            else -> false
+        }
+    }
+
+    private val anchorTag = Regex("(?is)<a\\b[^>]*>")
+    private val hrefAttribute = Regex("(?i)\\s+href\\s*=\\s*(?:\"([^\"]*)\"|'([^']*)'|([^\\s>]+))")
+
+    /** Remove unsafe href attributes without rewriting the document's other HTML. */
+    private fun sanitizeLinkTargets(html: String): String = anchorTag.replace(html) { match ->
+        val tag = match.value
+        val href = hrefAttribute.find(tag) ?: return@replace tag
+        val target = href.groups[1]?.value ?: href.groups[2]?.value ?: href.groups[3]?.value.orEmpty()
+        if (isAllowedLinkUrl(target)) tag else tag.removeRange(href.range)
+    }
