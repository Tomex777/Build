+    @Test
+    fun `new envelope declares a format version and keeps formatted html on reopen`() {
+        val document = LaterRichTextDocumentCodec.create(
+            html = "<h2><strong>Title</strong></h2><p><a href=\"https://example.com/note\">open</a></p>",
+            plainText = "Title\nopen"
+        )
+
+        assertTrue(document.contains("\"version\":1"))
+        assertEquals(
+            "<h2><strong>Title</strong></h2><p><a href=\"https://example.com/note\">open</a></p>",
+            LaterRichTextDocumentCodec.html(document)
+        )
+        assertEquals("Title\nopen", LaterRichTextDocumentCodec.plainText(document))
+    }
+
+    @Test
+    fun `unsafe saved link targets are removed without losing link text`() {
+        val crafted = LaterRichTextDocumentCodec.create(
+            html = "<p><a href=\"javascript:alert(1)\">keep this text</a></p>",
+            plainText = "keep this text"
+        )
+
+        assertEquals("<p><a>keep this text</a></p>", LaterRichTextDocumentCodec.html(crafted))
+        assertEquals("keep this text", LaterRichTextDocumentCodec.plainText(crafted))
+    }
+
+    @Test
+    fun `only standard navigable link schemes are accepted`() {
+        assertTrue(LaterRichTextDocumentCodec.isAllowedLinkUrl("https://example.com/path?q=1"))
+        assertTrue(LaterRichTextDocumentCodec.isAllowedLinkUrl("mailto:hello@example.com"))
+        assertTrue(LaterRichTextDocumentCodec.isAllowedLinkUrl("tel:+15551234567"))
+        assertTrue(!LaterRichTextDocumentCodec.isAllowedLinkUrl("javascript:alert(1)"))
+        assertTrue(!LaterRichTextDocumentCodec.isAllowedLinkUrl("data:text/html,hello"))
+        assertTrue(!LaterRichTextDocumentCodec.isAllowedLinkUrl("https://"))
     }
 
