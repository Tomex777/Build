+
+internal fun laterImageExportFormat(sourceMimeType: String?): LaterImageExportFormat =
+    when (sourceMimeType?.substringBefore(';')?.trim()?.lowercase()) {
+        "image/jpeg", "image/jpg" -> LaterImageExportFormat.JPEG
+        "image/webp" -> LaterImageExportFormat.WEBP
+        // PNG preserves alpha. Unknown formats use an explicit PNG copy rather
+        // than silently flattening transparent pixels into a JPEG.
+        else -> LaterImageExportFormat.PNG
+    }
