+package com.night.later.ui.media
+
+import org.junit.Assert.assertEquals
+import org.junit.Test
+
+class LaterImageExportFormatTest {
+    @Test
+    fun `jpeg stays jpeg`() {
+        assertEquals(LaterImageExportFormat.JPEG, laterImageExportFormat("image/jpeg"))
+        assertEquals(LaterImageExportFormat.JPEG, laterImageExportFormat("image/jpg; quality=high"))
+    }
+
+    @Test
+    fun `png and webp retain their output containers`() {
+        assertEquals(LaterImageExportFormat.PNG, laterImageExportFormat("image/png"))
+        assertEquals(LaterImageExportFormat.WEBP, laterImageExportFormat("image/webp"))
+    }
+
+    @Test
+    fun `unknown input uses alpha preserving png output`() {
+        assertEquals(LaterImageExportFormat.PNG, laterImageExportFormat("image/heic"))
+        assertEquals(LaterImageExportFormat.PNG, laterImageExportFormat(null))
+    }
+}
