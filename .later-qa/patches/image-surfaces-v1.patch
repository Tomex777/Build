+    private fun encryptOriginalMedia(
+        original: CapsuleMediaVersion,
+        blockDirectory: File,
+        identity: String
+    ): JSONObject {
+        val input = when {
+            !original.sourcePath.isNullOrBlank() && File(original.sourcePath).isFile ->
+                FileInputStream(File(original.sourcePath))
+            !original.sourceUri.isNullOrBlank() ->
+                context.contentResolver.openInputStream(Uri.parse(original.sourceUri))
+                    ?: error("Original attachment is unavailable.")
+            else -> error("Original attachment is unavailable.")
+        }
+        val encryptedInfo = input.use { source ->
+            FileOutputStream(File(blockDirectory, "original_payload.bin")).use { output ->
+                crypto.encryptStream(input = source, output = output, identity = identity)
+            }
+        }
+        File(blockDirectory, "original_content_iv.bin").writeBytes(encryptedInfo.contentIv)
+        File(blockDirectory, "original_wrapped_key.bin").writeBytes(encryptedInfo.wrappedKey)
+        File(blockDirectory, "original_wrapped_key_iv.bin").writeBytes(encryptedInfo.wrappedKeyIv)
+        return JSONObject()
+            .put("mimeType", original.mimeType)
+            .put("displayName", original.displayName)
+    }
