<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="CubicBaseTheme" parent="@android:style/Theme.Material.NoActionBar">
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowBackground">@color/cubic_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/cubic_background</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:colorAccent">@color/cubic_primary</item>
    </style>

    <style name="Theme.Cubic" parent="@style/CubicBaseTheme" />
</resources>
