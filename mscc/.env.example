# Optional VixSrc / VaPlayer stream-source tuning. Delivery uses ffmpeg -c copy only.
# MSCC_VIXSRC_HTTP_TIMEOUT_MS=30000
# MSCC_VIXSRC_CACHE_TTL_MS=120000
# MSCC_VAPLAYER_HTTP_TIMEOUT_MS=30000
# MSCC_VAPLAYER_CACHE_TTL_MS=120000
# MSCC_STREAM_COPY_TIMEOUT_MS=14400000

# Optional StreamingUnity tuning. HLS is remuxed with ffmpeg -c copy; video is not re-encoded.
# MSCC_STREAMINGUNITY_BASES=https://streamingunity.fun,https://streamingunity.win,https://streamingunity.vip
# MSCC_STREAMINGUNITY_LANGUAGE=en
# MSCC_STREAMINGUNITY_HTTP_TIMEOUT_MS=30000
# MSCC_STREAMINGUNITY_CACHE_TTL_MS=300000
# MSCC_STREAMINGUNITY_REMUX_TIMEOUT_MS=14400000

# MSCC Azure environment
# Existing A/B values are optional legacy migration inputs. New installs may
# leave them blank, start MSCC, then create/pair the first account from Cortex.
# Numbers are digits only, including country code, without +.

ACCOUNT_A_NUMBER=
ACCOUNT_B_NUMBER=

# Existing paired sessions keep these exact paths during migration.
ACCOUNT_A_AUTH_DIR=/var/lib/mscc/auth
ACCOUNT_B_AUTH_DIR=/var/lib/mscc/auth-b

ACCOUNT_REGISTRY_FILE=/var/lib/mscc/data/mscc-accounts.json
ACCOUNT_AUTH_ROOT=/var/lib/mscc/accounts
# Entitlement/plan limit. Basic can remain 2; premium can raise this without code changes.
MAX_ACCOUNTS=4

# Account A is always the main/control session and the fixed CC inbox.
# Additional sessions receive stable account-N IDs and may have friendly display names.

OWNER_NUMBER=
# Optional comma-separated control numbers.
# CONTROL_NUMBERS=234...,234...

# The Azure installer generates strong private values when these are blank/default.
WEB_PASSWORD=change-this-password
WEB_SESSION_SECRET=
# Cortex is the production UI. Keep the legacy browser/admin surface loopback-only.
MSCC_WEB_HOST=127.0.0.1
MSCC_WEB_PORT=8787

MESSAGE_INDEX_FILE=/var/lib/mscc/data/mscc-message-index.json
# Durable shared bot/profile/group/user/message state. This keeps long-lived data off the JS heap.
MSCC_SHARED_DB_FILE=/var/lib/mscc/data/mscc-shared.sqlite
SETTINGS_FILE=/var/lib/mscc/data/mscc-settings.json
CORTEX_SETTINGS_SCHEMA_FILE=/var/lib/mscc/data/cortex-settings-schema.json
CORTEX_RUNTIME_REGISTRY_FILE=/var/lib/mscc/data/cortex-runtime-registry.json
MSCC_ACTIVITY_FILE=/var/lib/mscc/data/mscc-activity.jsonl
MESSAGE_TTL_HOURS=24
# Maximum retained messages per account in the on-disk SQLite index (not an in-memory cache).
MAX_MESSAGE_CACHE=5000
GROUP_META_TTL_SECONDS=60
GROUP_META_CACHE_MAX=128


# Smart public AI for Josiah.
# Simple commands use local response pools; this is reserved for conversational/reasoning work.
# Keep real API keys only in /etc/mscc.env or Cortex's secure ENV editor; never commit them.
MSCC_SMART_AI_ENABLED=true
GROQ_API_KEY=
# Optional comma-separated rotating/failover key pool.
GROQ_API_KEYS=
# Highest-capability model first; later entries are model fallbacks.
GROQ_SMART_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b
MSCC_AI_TIMEOUT_MS=12000

# Optional TMDB application credentials used only for movie/TV identity,
# alternate-title matching, season metadata, and episode metadata.
# Media downloads still come from installed movie/TV source modules.
# Prefer the read access token; API key is supported as a fallback.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Optional Nyaa compact-release source tuning. Nyaa remains a user-selectable anime source.
# No transcoding is performed; these values only control discovery/download behavior.
# MSCC_NYAA_BASES=https://nyaa.si
# MSCC_NYAA_LIST_PAGES=3
# MSCC_NYAA_CACHE_TTL_MS=300000
# MSCC_NYAA_SEARCH_TIMEOUT_MS=25000
# MSCC_NYAA_MAX_FILE_MB=650
# MSCC_NYAA_METADATA_TIMEOUT_MS=90000
# MSCC_NYAA_DOWNLOAD_TIMEOUT_MS=2700000

# Compact text-only conversation history used for context and group summaries.
AI_HISTORY_DAYS=30
AI_HISTORY_MAX_PER_CHAT=25000

AUTH_BACKUP_DIR=/var/backups/mscc
LOG_LEVEL=silent
