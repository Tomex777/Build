# =========================
# WhatsApp accounts
# =========================
# Account A = primary account and default private CC inbox.
# Existing installs can keep BOT_NUMBER instead of ACCOUNT_A_NUMBER.
ACCOUNT_A_NUMBER=2348012345678
# BOT_NUMBER=2348012345678

# Account B. Leave blank to disable it.
ACCOUNT_B_NUMBER=

# Account A keeps the old ./auth directory so upgrading does not force a relink.
ACCOUNT_A_AUTH_DIR=./auth
ACCOUNT_B_AUTH_DIR=./auth-b

# All recovered media lands in this account's self-chat: A or B.
CC_DESTINATION_ACCOUNT=A

# WhatsApp command permissions.
OWNER_NUMBER=2348012345678
# CONTROL_NUMBERS=2348012345678,2348098765432

# =========================
# Private MSCC web panel
# =========================
# REQUIRED for the web panel. Use your own password.
WEB_PASSWORD=change-this-password

# Optional extra secret. If blank, WEB_PASSWORD still signs the login cookie.
WEB_SESSION_SECRET=

# Bot-Hosting.net injects SERVER_PORT automatically, so normally do NOT set a port there.
# On Azure/VPS, set MSCC_WEB_PORT if port 3000 is already used by another app.
# MSCC_WEB_PORT=8787
# MSCC always binds internally to 0.0.0.0. Legacy WEB_HOST values are ignored.

# Optional. The panel already learns its URL from the browser request.
# Set these only if you want it to also display live Bot-Hosting deployment metadata.
# BOT_HOSTING_API_KEY=bhk_xxxxxxxxx
# BOT_HOSTING_DEPLOYMENT_ID=dep_xxxxxxxxx
# PUBLIC_URL=https://example.com

# Re-pair never silently deletes auth; it moves the old local session here first.
AUTH_BACKUP_DIR=./data/auth-backups

# =========================
# Persistent message index
# =========================
MESSAGE_INDEX_FILE=./data/mscc-message-index.json
SETTINGS_FILE=./data/mscc-settings.json
MESSAGE_TTL_HOURS=24
# Per account. Two accounts at 5000 = up to 10000 indexed messages total.
MAX_MESSAGE_CACHE=5000

LOG_LEVEL=silent
