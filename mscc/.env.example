# MSCC Azure environment
# Numbers: digits only, including country code, no + sign.

ACCOUNT_A_NUMBER=
ACCOUNT_B_NUMBER=

ACCOUNT_A_AUTH_DIR=/var/lib/mscc/auth
ACCOUNT_B_AUTH_DIR=/var/lib/mscc/auth-b

CC_DESTINATION_ACCOUNT=A

OWNER_NUMBER=
# Optional: allow both of your accounts to control commands.
# CONTROL_NUMBERS=234...,234...

WEB_PASSWORD=change-this-password
WEB_SESSION_SECRET=
MSCC_WEB_PORT=8787

MESSAGE_INDEX_FILE=/var/lib/mscc/data/mscc-message-index.json
SETTINGS_FILE=/var/lib/mscc/data/mscc-settings.json
MESSAGE_TTL_HOURS=24
MAX_MESSAGE_CACHE=5000

AUTH_BACKUP_DIR=/var/backups/mscc
LOG_LEVEL=silent
