// Rename this file to something ending in .js when you are ready to enable it.
// commands/ is the normal/public command namespace.
// ownerOnly is a PUBLIC-command permission and is separate from MSCC private control.

export default {
  name: 'hello',
  aliases: ['hi'],
  description: 'Example public command.',
  ownerOnly: false,
  async run(ctx) {
    const who = ctx.args.join(' ').trim() || 'there'
    await ctx.reply(\`Hello \${who} 👋\`)
  },
}
