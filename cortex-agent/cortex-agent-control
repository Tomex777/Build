#!/usr/bin/env bash
set -euo pipefail

ACTION="${1:-}"
ENV_FILE=/etc/cortex-agent.env
RUNNER_USER=cortex-runner
RUNNER_GROUP=cortex-runner
RUNNER_UNIT=cortex-temporary-job.service

env_value() {
  local key="$1"
  [ -r "$ENV_FILE" ] || return 0
  sed -n "s/^$key=//p" "$ENV_FILE" | tail -n1 | tr -d '\r'
}

if [ "$ACTION" = "env-set" ]; then
  KEY="${2:-}"
  case "$KEY" in
    OWNER_NUMBER|CONTROL_NUMBERS|MAX_ACCOUNTS|MESSAGE_TTL_HOURS|MAX_MESSAGE_CACHE|GROUP_META_TTL_SECONDS|GROUP_META_CACHE_MAX|MSCC_PERSONALITY_AI_ENABLED|MSCC_SMART_AI_ENABLED|GROQ_API_KEY|GROQ_API_KEYS|GROQ_MODEL|GROQ_SMART_MODELS|MSCC_AI_TIMEOUT_MS|MSCC_AI_MAX_ATTEMPTS|AZURE_SPEECH_KEY|AZURE_SPEECH_REGION|AZURE_STT_LANGUAGE|AZURE_TTS_LANGUAGE|AZURE_TTS_VOICE|AZURE_OPENAI_ENDPOINT|AZURE_OPENAI_API_KEY|AZURE_OPENAI_VISION_DEPLOYMENT|AZURE_OPENAI_API_VERSION|MSCC_MEGA_EMAIL|MSCC_MEGA_PASSWORD|MSCC_MEGA_FOLDER|MSCC_MEGA_SHARED_FOLDERS|LOG_LEVEL) ;;
    *)
      echo "Environment key is not managed by Cortex." >&2
      exit 64
      ;;
  esac

  MSCC_ENV_FILE=/etc/mscc.env
  [ -f "$MSCC_ENV_FILE" ] || {
    echo "MSCC environment is unavailable." >&2
    exit 78
  }

  VALUE="$(cat)"
  case "$VALUE" in
    *$'\n'*|*$'\r'*)
      echo "Environment values must be a single line." >&2
      exit 64
      ;;
  esac

  TMP="$(mktemp "${MSCC_ENV_FILE}.cortex.XXXXXX")"
  trap 'rm -f "$TMP"' EXIT
  FOUND=0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "$KEY="*)
        printf '%s=%s\n' "$KEY" "$VALUE" >>"$TMP"
        FOUND=1
        ;;
      *)
        printf '%s\n' "$line" >>"$TMP"
        ;;
    esac
  done <"$MSCC_ENV_FILE"
  if [ "$FOUND" -ne 1 ]; then
    printf '%s=%s\n' "$KEY" "$VALUE" >>"$TMP"
  fi

  chown --reference="$MSCC_ENV_FILE" "$TMP"
  chmod --reference="$MSCC_ENV_FILE" "$TMP"
  # The write is atomic: replacing /etc/mscc.env loses the previous named
  # ACL. Preserve the *only* extra reader needed by Cortex Cloud; do not
  # relax root ownership or grant the transient job runner any access.
  if id -u cortex-agent >/dev/null 2>&1; then
    command -v setfacl >/dev/null || {
      echo "Required ACL tool unavailable; refusing to remove Cortex environment access." >&2
      exit 78
    }
    setfacl -m 'u:cortex-agent:r--' "$TMP"
  fi
  mv -f "$TMP" "$MSCC_ENV_FILE"
  trap - EXIT
  exit 0
fi

# Narrow privileged write for the single NIGHT command-settings JSON. The
# unprivileged Agent may read settings but deliberately cannot write into the
# private MSCC data directory. Accept only a schema-listed boolean key.
if [ "$ACTION" = "setting-set" ]; then
  KEY="${2:-}"
  [[ "$KEY" =~ ^[A-Za-z_][A-Za-z0-9._-]{0,79}$ ]] || {
    echo "Invalid setting key." >&2
    exit 64
  }
  VALUE="$(cat)"
  [[ "$VALUE" == true || "$VALUE" == false ]] || {
    echo "A boolean value is required." >&2
    exit 64
  }
  exec /usr/bin/node /usr/local/libexec/cortex-agent-settings-write.cjs \
    /var/lib/mscc/data/cortex-settings-schema.json \
    /var/lib/mscc/data/mscc-settings.json \
    "$KEY" "$VALUE"
fi

if [ "$ACTION" = "runner-start" ]; then
  [ -r "$ENV_FILE" ] || {
    echo "Cortex Agent environment is unavailable." >&2
    exit 78
  }
  id -u "$RUNNER_USER" >/dev/null 2>&1 || {
    echo "Cortex runner user is unavailable." >&2
    exit 78
  }

  REL="${2:-}"
  case "$REL" in
    ""|/*|*$'\n'*|*$'\r'*)
      echo "Invalid runner entry." >&2
      exit 64
      ;;
  esac

  IFS='/' read -r -a PARTS <<<"$REL"
  for part in "${PARTS[@]}"; do
    case "$part" in
      ""|"."|".."|.*)
        echo "Invalid runner entry." >&2
        exit 64
        ;;
    esac
  done

  case "$REL" in
    *.js) RUNTIME="$(command -v node)" ;;
    *.sh) RUNTIME=/usr/bin/bash ;;
    *)
      echo "Runner entry must be a .js or .sh file." >&2
      exit 64
      ;;
  esac

  PROJECT_ROOT="$(env_value CORTEX_PROJECT_ROOT)"
  [ -n "$PROJECT_ROOT" ] || PROJECT_ROOT=/opt/mscc/current
  STATE_DIR="$(env_value CORTEX_STATE_DIR)"
  [ -n "$STATE_DIR" ] || STATE_DIR=/var/lib/cortex
  RUNNER_DIR="$STATE_DIR/runner"
  RUNNER_LOG="$RUNNER_DIR/foreground.log"
  RUNNER_STATE="$RUNNER_DIR/foreground.state"
  READER_USER="${SUDO_USER:-cortex-agent}"
  if ! id -u "$READER_USER" >/dev/null 2>&1; then
    READER_USER=cortex-agent
  fi
  READER_GROUP="$(id -gn "$READER_USER")"
  ROOT_REAL="$(readlink -f "$PROJECT_ROOT" 2>/dev/null || true)"
  [ -n "$ROOT_REAL" ] && [ -d "$ROOT_REAL" ] || {
    echo "Configured project root is unavailable." >&2
    exit 78
  }

  CURRENT="$ROOT_REAL"
  for part in "${PARTS[@]}"; do
    CURRENT="$CURRENT/$part"
    [ ! -L "$CURRENT" ] || {
      echo "Runner entry cannot traverse a symlink." >&2
      exit 77
    }
  done

  TARGET="$(readlink -f "$ROOT_REAL/$REL" 2>/dev/null || true)"
  case "$TARGET" in
    "$ROOT_REAL"/*) ;;
    *)
      echo "Runner entry escaped the project root." >&2
      exit 77
      ;;
  esac
  [ -f "$TARGET" ] || {
    echo "Runner entry does not exist." >&2
    exit 66
  }

  install -d -o "$READER_USER" -g "$READER_GROUP" -m 0750 "$RUNNER_DIR"
  : >"$RUNNER_LOG"
  chown "$READER_USER":"$READER_GROUP" "$RUNNER_LOG"
  chmod 0640 "$RUNNER_LOG"
  printf 'path=%s\nstartedAt=%s\n' "$REL" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" >"$RUNNER_STATE"
  chown "$READER_USER":"$READER_GROUP" "$RUNNER_STATE"
  chmod 0640 "$RUNNER_STATE"

  systemctl stop "$RUNNER_UNIT" >/dev/null 2>&1 || true
  systemctl reset-failed "$RUNNER_UNIT" >/dev/null 2>&1 || true

  PRIVATE_TMP_ARGS=(--property=PrivateTmp=yes)
  case "$ROOT_REAL" in
    /tmp/*|/var/tmp/*) PRIVATE_TMP_ARGS=() ;;
  esac

  INACCESSIBLE_ARGS=()
  for protected in /etc/mscc.env /etc/cortex-agent.env /var/lib/mscc /var/lib/cortex; do
    if [ -e "$protected" ]; then
      INACCESSIBLE_ARGS+=(--property="InaccessiblePaths=$protected")
    fi
  done
  while IFS= read -r -d '' protected; do
    INACCESSIBLE_ARGS+=(--property="InaccessiblePaths=$protected")
  done < <(
    find "$ROOT_REAL" -maxdepth 4 \
      \( -type l -print0 \) -o \
      \( -type d \( -name .git -o -name .ssh -o -name .gradle -o -name .cortex \) -print0 -prune \) -o \
      \( -type f \( -name '.env*' -o -name '*.pem' -o -name '*.p12' -o -name '*.pfx' -o -name '*.key' -o -name '*.keystore' -o -name id_rsa -o -name id_ed25519 -o -name id_ecdsa -o -name id_dsa \) -print0 \)
  )

  systemd-run \
    --quiet \
    --unit="$RUNNER_UNIT" \
    --service-type=exec \
    --uid="$RUNNER_USER" \
    --gid="$RUNNER_GROUP" \
    --working-directory="$ROOT_REAL" \
    --setenv=PATH=/usr/local/bin:/usr/bin:/bin \
    --setenv=HOME=/var/lib/cortex-runner \
    --setenv=NODE_ENV=production \
    --setenv=LANG=C.UTF-8 \
    --property=RemainAfterExit=yes \
    --property=NoNewPrivileges=yes \
    "${PRIVATE_TMP_ARGS[@]}" \
    --property=PrivateDevices=yes \
    --property=ProtectSystem=strict \
    --property=ProtectHome=yes \
    --property=ProtectKernelTunables=yes \
    --property=ProtectKernelModules=yes \
    --property=ProtectControlGroups=yes \
    --property=RestrictSUIDSGID=yes \
    --property=LockPersonality=yes \
    --property=UMask=0077 \
    --property="ReadWritePaths=$ROOT_REAL" \
    "${INACCESSIBLE_ARGS[@]}" \
    --property="StandardOutput=append:$RUNNER_LOG" \
    --property="StandardError=append:$RUNNER_LOG" \
    -- "$RUNTIME" "$TARGET"
  exit 0
fi

if [ "$ACTION" = "runner-stop" ]; then
  systemctl kill --kill-who=all --signal=SIGTERM "$RUNNER_UNIT" >/dev/null 2>&1 || true
  for _ in 1 2 3 4 5; do
    state="$(systemctl is-active "$RUNNER_UNIT" 2>/dev/null || true)"
    [ "$state" != "active" ] && break
    sleep 1
  done
  state="$(systemctl is-active "$RUNNER_UNIT" 2>/dev/null || true)"
  if [ "$state" = "active" ]; then
    systemctl kill --kill-who=all --signal=SIGKILL "$RUNNER_UNIT" >/dev/null 2>&1 || true
  fi
  systemctl stop "$RUNNER_UNIT" >/dev/null 2>&1 || true
  exit 0
fi

case "$ACTION" in
  start|stop|restart|enable|disable) ;;
  *)
    echo "Unsupported Cortex service action." >&2
    exit 64
    ;;
esac

[ -r "$ENV_FILE" ] || {
  echo "Cortex Agent environment is unavailable." >&2
  exit 78
}

SERVICE="$(env_value CORTEX_SERVICE)"
[ -n "$SERVICE" ] || SERVICE=mscc.service

case "$SERVICE" in
  ""|*[!A-Za-z0-9_.@-]*)
    echo "Invalid managed service name." >&2
    exit 78
    ;;
esac
case "$SERVICE" in
  *.service) ;;
  *)
    echo "Managed service must be a .service unit." >&2
    exit 78
    ;;
esac

exec /usr/bin/systemctl "$ACTION" "$SERVICE"
