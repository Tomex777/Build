+        val width = 420f
+        val height = 850f
+        val start = SlumberTilesChart.heldBounds(hold, 1_200L, width, height)
+        val halfway = SlumberTilesChart.heldBounds(hold, 1_750L, width, height)
+        val end = SlumberTilesChart.heldBounds(hold, 2_300L, width, height)
+        assertEquals(height * .955f, start.bottom, .001f)
+        assertEquals(start.bottom, halfway.bottom, .001f)
+        assertEquals(start.bottom, end.bottom, .001f)
