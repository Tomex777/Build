+    /** Hold tails are anchored to the touch area and shrink smoothly, instead of
+     * continuing to fall after the finger has grabbed them. The tail reaches
+     * zero height at the exact duration boundary, independently of frame rate. */
+    fun heldBounds(tile: SlumberTile, playheadMs: Long, fieldWidth: Float, fieldHeight: Float): TileVerticalBounds {
+        val hitY = fieldHeight * .955f
+        val fullHeight = verticalBounds(tile, tile.onsetMs, fieldWidth, fieldHeight).let { it.bottom - it.top }
+        val remainingFraction = ((tile.onsetMs + tile.durationMs - playheadMs).toFloat() /
+            tile.durationMs.coerceAtLeast(1L)).coerceIn(0f, 1f)
+        return TileVerticalBounds(hitY - fullHeight * remainingFraction, hitY)
+    }
