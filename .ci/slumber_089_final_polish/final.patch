+    /** Freezes timed Play without turning time spent in the background into misses. */
+    fun pauseTimeline(timestampMs: Long = monotonicNowMs()): PerformanceUpdate {
+        if (scoreStartMs != null && timelinePausedAtMs == null) {
+            timelinePausedAtMs = timestampMs
+            activeNotes.clear()
+        }
+        return update()
+    }
+
+    /** Resumes a paused timeline by moving its timing anchor past the suspended gap. */
+    fun resumeTimeline(timestampMs: Long = monotonicNowMs()): PerformanceUpdate {
+        val pausedAt = timelinePausedAtMs ?: return update()
+        val gap = (timestampMs - pausedAt).coerceAtLeast(0L)
+        scoreStartMs = scoreStartMs?.plus(gap)
+        timelinePausedAtMs = null
+        return update()
+    }
