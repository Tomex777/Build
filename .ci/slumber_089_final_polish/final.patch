+    @Test
+    fun pausedTimelineIgnoresBackgroundGapForTiming() {
+        val engine = PerformanceEngine("pause", listOf(60, 64), 60)
+        engine.startTimeline(1_000L)
+        engine.noteOn(60, 1_000L, source = PlayingInputSource.TOUCH)
+        engine.pauseTimeline(1_200L)
+        engine.resumeTimeline(6_200L)
+        val result = engine.noteOn(64, 7_000L, source = PlayingInputSource.TOUCH)
+
+        assertTrue(result.completed)
+        assertEquals(0, result.missedNotes)
+        assertEquals(100, result.timingPercent)
+    }
