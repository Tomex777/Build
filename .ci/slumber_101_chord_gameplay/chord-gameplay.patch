+private fun chordOriginalLesson(
+    id: String,
+    title: String,
+    tempoBpm: Int,
+    difficulty: String,
+    atmosphere: LessonAtmosphere,
+    chords: List<Pair<String, Set<Int>>>,
+): PianoLesson {
+    require(chords.isNotEmpty())
+    require(chords.all { (_, notes) -> notes.size >= 2 && notes.all { it in 21..108 } })
+    val beatMs = 60_000L / tempoBpm
+    val durationMs = (beatMs * .72).toLong().coerceAtLeast(120L)
+    val chart = chords.flatMapIndexed { chordIndex, (_, notes) ->
+        val startMs = chordIndex * beatMs
+        notes.sorted().mapIndexed { noteIndex, midi ->
+            PianoChartNote(
+                midi = midi,
+                timeMs = startMs,
+                durationMs = durationMs,
+                velocity = if (noteIndex == 0) .82f else .76f,
+                staff = 1,
+                fingering = (noteIndex + 1).coerceAtMost(5),
+            )
+        }
+    }
+    return PianoLesson(
+        id = id,
+        title = title,
+        subtitle = "Slumber Originals · chord drill",
+        tempoBpm = tempoBpm,
+        difficulty = difficulty,
+        phrases = listOf(PianoLessonPhrase("Cadence", chords.flatMap { it.second.sorted() })),
+        publicDomain = false,
+        collection = LessonCollection.ORIGINAL,
+        chartNotes = chart,
+        sections = listOf(PianoLessonSection("Cadence", 0L)),
+        atmosphere = atmosphere,
+        tonicMidi = 60,
+    )
+}
