@@ -0,0 +1,23 @@
+package com.night.pianohub.music
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class PianoLessonCatalogTest {
+    @Test
+    fun velvetCadenceIsARealChordChart() {
+        val lesson = PianoLessonCatalog.find("original-velvet-cadence")
+        val moments = lesson.timelineMoments()
+
+        assertEquals("Slumber Originals · chord drill", lesson.subtitle)
+        assertEquals(5, moments.size)
+        assertTrue(moments.all { it.notes.size == 3 })
+        assertEquals(setOf(60, 64, 67), moments.first().notes)
+        assertEquals(setOf(57, 60, 64), moments[1].notes)
+        assertEquals(setOf(53, 57, 60), moments[2].notes)
+        assertEquals(setOf(55, 59, 62), moments[3].notes)
+        assertEquals(setOf(60, 64, 67), moments.last().notes)
+        assertTrue(lesson.chartNotes.groupBy { it.timeMs }.values.all { it.size == 3 })
+    }
+}

