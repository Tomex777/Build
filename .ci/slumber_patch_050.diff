+package com.night.pianohub.learner
+
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class AdaptivePracticePlannerTest {
+    @Test
+    fun cleanPerformanceDoesNotInventTroubleSpot() {
+        val score = ExerciseScore.melody(listOf(60, 62, 64, 65))
+        val engine = PerformanceEngine("clean", score, 120)
+        val start = 1_000L
+        score.moments.forEachIndexed { index, moment ->
+            engine.noteOn(moment.notes.single(), start + index * 500L, source = PlayingInputSource.MIDI)
+        }
+        val plan = AdaptivePracticePlanner.createPlan("clean", score, 120, engine.eventsSnapshot(), engine.summary())
+        assertNull(plan)
+    }
+
+    @Test
+    fun skipRecoveryCreatesFocusedSlowerPlan() {
+        val score = ExerciseScore.melody(listOf(60, 62, 64, 65, 67, 69, 71, 72))
+        val engine = PerformanceEngine("phrase", score, 100)
+        val start = 10_000L
+        engine.noteOn(60, start, source = PlayingInputSource.MIDI)
+        engine.noteOn(62, start + 600L, source = PlayingInputSource.MIDI)
+        engine.noteOn(67, start + 2_400L, source = PlayingInputSource.MIDI)
+        engine.noteOn(69, start + 3_000L, source = PlayingInputSource.MIDI)
+
+        val plan = AdaptivePracticePlanner.createPlan("phrase", score, 100, engine.eventsSnapshot(), engine.summary())
+        assertNotNull(plan)
+        plan!!
+        assertEquals(PracticeIssueKind.PITCH, plan.troubleSpot.issue)
+        assertTrue(plan.troubleSpot.startMomentIndex <= 2)
+        assertTrue(plan.troubleSpot.endMomentIndex - plan.troubleSpot.startMomentIndex <= 3)
+        assertTrue(plan.startingTempoBpm < 100)
+        assertTrue(plan.nextTempo(plan.startingTempoBpm) > plan.startingTempoBpm)
+    }
+
+    @Test
+    fun timingErrorCanBecomeDominantIssue() {
+        val score = ExerciseScore.melody(listOf(60, 62, 64, 65, 67))
+        val engine = PerformanceEngine("timing", score, 120)
+        val start = 20_000L
+        engine.noteOn(60, start, source = PlayingInputSource.MIDI)
+        engine.noteOn(62, start + 700L, source = PlayingInputSource.MIDI)
+        engine.noteOn(64, start + 1_400L, source = PlayingInputSource.MIDI)
+        engine.noteOn(65, start + 2_100L, source = PlayingInputSource.MIDI)
+        engine.noteOn(67, start + 2_800L, source = PlayingInputSource.MIDI)
+
+        val plan = AdaptivePracticePlanner.createPlan("timing", score, 120, engine.eventsSnapshot(), engine.summary())
+        assertNotNull(plan)
+        assertEquals(PracticeIssueKind.TIMING, plan!!.troubleSpot.issue)
+    }
+}
