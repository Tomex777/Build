+package com.night.pianohub.learner
+
+import kotlin.math.abs
+import kotlin.math.roundToInt
+
+enum class PracticeIssueKind(val title: String) {
+    PITCH("Pitch accuracy"),
+    TIMING("Timing"),
+    REPEATS("Repeated notes"),
+    EXTRAS("Extra notes"),
+    CHORD_SYNC("Chord synchronization"),
+}
+
+data class TroubleSpot(
+    val startMomentIndex: Int,
+    val endMomentIndex: Int,
+    val issue: PracticeIssueKind,
+    val severity: Int,
+    val reason: String,
+) {
+    init {
+        require(startMomentIndex >= 0)
+        require(endMomentIndex >= startMomentIndex)
+        require(severity in 1..100)
+    }
+}
+
+data class FixThisPlan(
+    val exerciseName: String,
+    val troubleSpot: TroubleSpot,
+    val originalTempoBpm: Int,
+    val startingTempoBpm: Int,
+    val tempoStepBpm: Int,
+    val successAccuracyPercent: Int = 90,
+    val successTimingPercent: Int = 80,
+    val requiredCleanRuns: Int = 2,
+) {
+    init {
+        require(originalTempoBpm in 20..300)
+        require(startingTempoBpm in 20..originalTempoBpm)
+        require(tempoStepBpm > 0)
+        require(successAccuracyPercent in 1..100)
+        require(successTimingPercent in 1..100)
+        require(requiredCleanRuns in 1..10)
+    }
+
+    fun nextTempo(currentTempoBpm: Int): Int =
+        (currentTempoBpm + tempoStepBpm).coerceAtMost(originalTempoBpm)
+}
+
+/**
+ * Local deterministic adaptive-practice planner.
+ *
+ * It deliberately consumes facts produced by [PerformanceEngine] instead of
+ * asking a language model to guess what went wrong. The LLM teacher can explain
+ * the plan later, but the trouble-spot decision remains local and reproducible.
+ */
+object AdaptivePracticePlanner {
+    fun createPlan(
+        exerciseName: String,
+        score: ExerciseScore,
+        targetTempoBpm: Int,
+        events: List<PracticeEvent>,
+        summary: PracticeSessionSummary,
+    ): FixThisPlan? {
+        if (events.isEmpty() || summary.attempts <= 0 || score.moments.isEmpty()) return null
+        if (summary.completed && summary.accuracyPercent >= 96 && summary.timingPercent >= 90 &&
+            summary.extraNotes == 0 && summary.repeatedNotes == 0 && summary.missedNotes == 0
+        ) return null
+
+        val penalties = IntArray(score.moments.size)
+        val pitchPenalties = IntArray(score.moments.size)
+        val timingPenalties = IntArray(score.moments.size)
+        val repeatPenalties = IntArray(score.moments.size)
+        val extraPenalties = IntArray(score.moments.size)
+
+        events.forEach { event ->
+            val index = event.expectedMomentIndex?.coerceIn(0, score.moments.lastIndex) ?: return@forEach
+            when (event.classification) {
+                PerformanceClassification.HIT -> Unit
+                PerformanceClassification.SKIP_RECOVERY -> {
+                    penalties[index] += 45
+                    pitchPenalties[index] += 45
+                }
+                PerformanceClassification.REPEATED_NOTE -> {
+                    penalties[index] += 34
+                    repeatPenalties[index] += 34
+                }
+                PerformanceClassification.EXTRA_NOTE,
+                PerformanceClassification.AFTER_COMPLETION -> {
+                    penalties[index] += 30
+                    extraPenalties[index] += 30
+                }
+            }
+
+            event.timingErrorMs?.let { error ->
+                val absolute = abs(error)
+                if (absolute >= 45L) {
+                    val timingPenalty = when {
+                        absolute >= 220L -> 36
+                        absolute >= 140L -> 28
+                        absolute >= 90L -> 20
+                        else -> 12
+                    }
+                    penalties[index] += timingPenalty
+                    timingPenalties[index] += timingPenalty
+                }
+            }
+        }
+
+        if (summary.missedNotes > 0) {
+            val recoveryIndex = events.firstOrNull { it.classification == PerformanceClassification.SKIP_RECOVERY }
+                ?.expectedMomentIndex
+            if (recoveryIndex != null && recoveryIndex in penalties.indices) {
+                val bonus = (summary.missedNotes * 22).coerceAtMost(60)
+                penalties[recoveryIndex] += bonus
+                pitchPenalties[recoveryIndex] += bonus
+            }
+        }
+
+        val peakIndex = penalties.indices.maxByOrNull { penalties[it] } ?: return null
+        if (penalties[peakIndex] <= 0) return fallbackPlan(exerciseName, score, targetTempoBpm, summary)
+
+        val maxWindow = minOf(4, score.moments.size)
+        var bestStart = peakIndex
+        var bestEnd = peakIndex
+        var bestScore = Int.MIN_VALUE
+        for (length in 1..maxWindow) {
+            val minStart = (peakIndex - length + 1).coerceAtLeast(0)
+            val maxStart = peakIndex.coerceAtMost(score.moments.size - length)
+            for (start in minStart..maxStart) {
+                val end = start + length - 1
+                val windowPenalty = (start..end).sumOf { penalties[it] } - (length - 1) * 5
+                if (windowPenalty > bestScore) {
+                    bestScore = windowPenalty
+                    bestStart = start
+                    bestEnd = end
+                }
+            }
+        }
+
+        val issue = dominantIssue(bestStart, bestEnd, pitchPenalties, timingPenalties, repeatPenalties, extraPenalties, summary)
+        val severity = ((bestScore.coerceAtLeast(1) * 100f) / 120f).roundToInt().coerceIn(1, 100)
+        val reason = reasonFor(issue, summary)
+        return plan(exerciseName, targetTempoBpm, TroubleSpot(bestStart, bestEnd, issue, severity, reason))
+    }
+
+    private fun fallbackPlan(
+        exerciseName: String,
+        score: ExerciseScore,
+        targetTempoBpm: Int,
+        summary: PracticeSessionSummary,
+    ): FixThisPlan? {
+        val issue = when {
+            summary.timingPercent in 1..79 -> PracticeIssueKind.TIMING
+            summary.chordSyncPercent in 1..79 -> PracticeIssueKind.CHORD_SYNC
+            summary.repeatedNotes > 0 -> PracticeIssueKind.REPEATS
+            summary.extraNotes > 0 -> PracticeIssueKind.EXTRAS
+            summary.accuracyPercent in 1..89 || summary.missedNotes > 0 -> PracticeIssueKind.PITCH
+            else -> return null
+        }
+        val end = minOf(score.moments.lastIndex, 3)
+        return plan(
+            exerciseName,
+            targetTempoBpm,
+            TroubleSpot(0, end, issue, 40, reasonFor(issue, summary)),
+        )
+    }
+
+    private fun dominantIssue(
+        start: Int,
+        end: Int,
+        pitch: IntArray,
+        timing: IntArray,
+        repeats: IntArray,
+        extras: IntArray,
+        summary: PracticeSessionSummary,
+    ): PracticeIssueKind {
+        val totals = linkedMapOf(
+            PracticeIssueKind.PITCH to (start..end).sumOf { pitch[it] },
+            PracticeIssueKind.TIMING to (start..end).sumOf { timing[it] },
+            PracticeIssueKind.REPEATS to (start..end).sumOf { repeats[it] },
+            PracticeIssueKind.EXTRAS to (start..end).sumOf { extras[it] },
+            PracticeIssueKind.CHORD_SYNC to if (summary.chordSyncPercent in 1..79) 18 else 0,
+        )
+        return totals.maxByOrNull { it.value }?.key ?: PracticeIssueKind.PITCH
+    }
+
+    private fun plan(exerciseName: String, targetTempoBpm: Int, spot: TroubleSpot): FixThisPlan {
+        val slowdown = when {
+            spot.severity >= 80 -> 0.58
+            spot.severity >= 60 -> 0.66
+            spot.severity >= 40 -> 0.72
+            else -> 0.78
+        }
+        val startTempo = (targetTempoBpm * slowdown).roundToInt().coerceIn(20, targetTempoBpm)
+        val step = maxOf(4, ((targetTempoBpm - startTempo) / 3.0).roundToInt())
+        return FixThisPlan(
+            exerciseName = exerciseName,
+            troubleSpot = spot,
+            originalTempoBpm = targetTempoBpm,
+            startingTempoBpm = startTempo,
+            tempoStepBpm = step,
+        )
+    }
+
+    private fun reasonFor(issue: PracticeIssueKind, summary: PracticeSessionSummary): String = when (issue) {
+        PracticeIssueKind.PITCH -> "${summary.missedNotes} missed · ${summary.accuracyPercent}% pitch accuracy"
+        PracticeIssueKind.TIMING -> "${summary.averageAbsoluteTimingErrorMs} ms average timing error · ${summary.timingPercent}% timing"
+        PracticeIssueKind.REPEATS -> "${summary.repeatedNotes} repeated note${if (summary.repeatedNotes == 1) "" else "s"} while recovering"
+        PracticeIssueKind.EXTRAS -> "${summary.extraNotes} extra note${if (summary.extraNotes == 1) "" else "s"}"
+        PracticeIssueKind.CHORD_SYNC -> "${summary.chordSyncPercent}% chord synchronization"
+    }
+}
