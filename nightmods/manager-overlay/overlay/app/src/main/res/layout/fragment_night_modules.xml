<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" app:consumeSystemWindowsInsets="@integer/internal_fragment_insets" app:edgeToEdge="true" app:fitsSystemWindowsInsets="@integer/internal_fragment_insets">
