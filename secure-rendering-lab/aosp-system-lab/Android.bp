android_app {
    name: "SecureRenderingSystemLab",
    manifest: "AndroidManifest.xml",
    srcs: ["src/**/*.java"],
    certificate: "platform",
    privileged: true,
    platform_apis: true,
    system_ext_specific: true,
    min_sdk_version: "26",
    optimize: {
        enabled: false,
    },
    required: [
        "secure_rendering_system_lab_permissions",
    ],
}

prebuilt_etc {
    name: "secure_rendering_system_lab_permissions",
    src: "privapp-permissions-com.tomex.securerenderlab.system.xml",
    sub_dir: "permissions",
    filename_from_src: true,
    system_ext_specific: true,
}
