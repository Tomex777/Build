      "Jèhófà ńlá, èmi",
      "Gbogbo ẹ̀dá jẹ́wọ́",
      "Mo fi ìbùkún f'orúkọ Rẹ títí láé."
    ],
    [
      "Yin Ọlọ́run Ábúráhámù",
      "Nípàṣẹ Ẹni tí",
      "Mo dìde, mo sì wá ìtùnú lọ́wọ́ ọ̀tún Rẹ",
      "Mo kọ ayé sílẹ̀",
      "Ọgbọ́n àti ọlá Rẹ",
      "Òun nikan sì ni ìpín mi àti àsà mi."
    ],
    [
      "Òun náà ti ṣe ìlérí",
      "Mo gbẹ́kẹ̀lé èyí",
      "Yóò jẹ́ kí ìmọ́lẹ̀ ọ̀run rí mi lọ́jọ́ ìpẹ̀yà",
      "Ní gbogbo ìrìn mi",
      "Yóò jẹ́ ìtọ́sọ́nà mi",
      "Òun ni ìrètí mi nígbà gbogbo."
    ],
    [
      "Mo ń kọjá aginjù ayé",
      "Bí Jésù wà lọ́kàn",
      "N ó kọjá nínú ìgbó dídì lọ sí ọ̀nà mi",
      "Ọlọ́run tó ń tọ́ mí",
      "Kì í fi ọmọ Rẹ sílẹ̀",
      "N ó dúró ṣinṣin nínú ìfẹ́ Rẹ."
    ],
    [
      "Ọba òkè ọ̀run",
      "Olórí àńgẹ́lì ń ké",
      "Wí pé Mímọ́, Mímọ́, Mímọ́, Ọba títí",
      "Ẹni tí kì í padà",
      "Tí yóò sì wà láéláé",
      "Jèhófà, Baba, a yin Ọ."
    ],
    [
      "Gbogbo ẹgbẹ́ aṣẹ́gun",
      "Ń yin Ọlọ́run lókè",
      "Baba, Ọmọ àti Ẹ̀mí ni wọ́n ń ké títí",
      "Yin Ọlọ́run Ábúráhámù",
      "N ó bá wọn kọrin náà",
      "Tirẹ ni agbára àti ọlá pẹ̀lú ìyìn."
    ]
