    {
      "number": 4,
      "collection": "main",
      "title_yo": "Níwájú ìtẹ́ àánú",
      "title_en": "We Worship and Adore Thee",
      "source_pages": [
        2
      ],
      "verses_yo": [
        [
          "Níwájú ìtẹ́ àánú",
          "Àwa wọlé fún Ọ",
          "Àwa ń yin Ọ, Olúwa",
          "Ó dùn láti mọ Ọ."
        ],
        [
          "Àwa ń júbà Rẹ Jésù",
          "Ẹni tí a pa fún wa",
          "Ìwọ tó ń jọba lókè",
          "Tó sì tún ń padà bọ̀."
        ],
        [
          "Àwa ń júbà Rẹ Jésù",
          "Fún ìràpadà wa",
          "Ìwọ fẹ́ wa láìfẹ̀tàn",
          "Àwa yóò máa yin Ọ."
        ],
        [
          "Àwa ń júbà Rẹ Jésù",
          "Ọpẹ́ ńlá ló yẹ Ọ",
          "Títí la ó máa yin Ọ",
          "A ó sì ṣe Ọ l'Ọba."
        ]
      ],
      "verses_en": [],
      "text_status": "draft_photo_checked",
      "source_url": "https://gospelsongs.com.ng/niwaju-ite-anu-yoruba-hymn/"
    },
