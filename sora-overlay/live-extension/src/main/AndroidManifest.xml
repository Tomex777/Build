<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:label="Sora Live Sources"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <service
            android:name=".LiveExtensionService"
            android:exported="true"
            android:process=":sora_live_extension">
            <intent-filter>
                <action android:name="com.night.sora.extension.BIND" />
            </intent-filter>
            <meta-data android:name="sora.extension.id" android:value="night.sora.live.sources" />
            <meta-data android:name="sora.extension.name" android:value="Sora Live Sources" />
            <meta-data android:name="sora.extension.apiVersion" android:value="1" />
        </service>
    </application>
</manifest>
