<resources>
    <style name="Theme.MirrorChess" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">@color/mirrorchess_icon_background</item>
        <item name="android:statusBarColor">@color/mirrorchess_icon_background</item>
        <item name="android:windowBackground">@color/mirrorchess_icon_background</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowSplashScreenBackground">@color/mirrorchess_icon_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="android:windowSplashScreenIconBackgroundColor">@color/mirrorchess_icon_background</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
