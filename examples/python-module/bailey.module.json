{
  "protocol": 1,
  "id": "python-example",
  "name": "Python Example",
  "version": "1.0.0",
  "description": "Protocol 1 Python example: commands, events, a scheduled job, lifecycle and host services.",
  "runtime": {
    "command": "python",
    "args": ["main.py"]
  },
  "capabilities": ["commands", "settings", "events", "jobs", "services", "storage", "lifecycle"],
  "permissions": ["whatsapp.send", "whatsapp.react", "storage.read", "storage.write", "network.http"],
  "events": ["message.received"],
  "jobs": [
    {
      "id": "daily-summary",
      "intervalSeconds": 86400,
      "retry": { "maxAttempts": 3, "backoffSeconds": 30 }
    }
  ],
  "settings": [
    {
      "key": "greeting",
      "label": "Greeting",
      "type": "text",
      "defaultValue": "Hello",
      "env": "PYTHON_EXAMPLE_GREETING",
      "description": "Text used by the Python reply."
    }
  ],
  "commands": [
    {
      "id": "pyhello",
      "name": "pyhello",
      "section": "Examples",
      "description": "Reply from a Python Bailey module.",
      "aliases": ["pyhi"]
    }
  ]
}
